# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Main server: slash commands are registered here and web logins must be members of it.
DISCORD_GUILD_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Defaults to ${WEB_BASE_URL}/auth/callback
DISCORD_OAUTH_REDIRECT_URI=

# --- Roles ---
ADMIN_USER_ID=
TOURNAMENT_OPERATOR_ID=

# --- MugCoins / tournaments (only enabled in this server) ---
CURRENCY_GUILD_ID=
# Optional tuning (defaults shown)
# CURRENCY_STARTING_BALANCE=500
# CURRENCY_MESSAGE_REWARD=1
# CURRENCY_MESSAGE_REWARD_COOLDOWN_SECS=60
# CURRENCY_DAILY_BASE=50
# CURRENCY_DAILY_STREAK_BONUS=10
# CURRENCY_DAILY_STREAK_CAP=7
# CURRENCY_POLL_VOTE_REWARD=5

# --- Channels ---
CHANNEL_MUSICART_WEBHOOK_ID=
CHANNEL_LOVELIVE_MUSIC_ID=
CHANNEL_DAILY_FACTS_ID=
CHANNEL_TOURNAMENT_UPDATES_ID=

# --- Third-party APIs ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_ID=
WORDNIK_API_KEY=
# Free tier works; free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Web dashboard ---
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me

# --- Storage ---
# DATA_DIR=data
# DATABASE_PATH=data/watanabebot.db
# Set once, only for an intentional first boot in production with an empty data volume.
# ALLOW_DATABASE_BOOTSTRAP=true

# Logging, e.g. info,watanabebot=debug
# RUST_LOG=info
